{
  "name": "opencoach",
  "version": "1.3.0",
  "private": true,
  "description": "openCOACH: training, nutrition and bodyweight. One codebase for the web app (GitHub Pages) and the iOS / Android store apps (Capacitor).",
  "scripts": {
    "test": "node gains-core.test.js && node --test macros-core.test.js",
    "build": "node scripts/build-web.mjs",
    "sync": "npm run build && npx cap sync",
    "ios": "npm run sync && npx cap open ios",
    "android": "npm run sync && npx cap open android",
    "assets": "npx capacitor-assets generate --iconBackgroundColor '#111114' --iconBackgroundColorDark '#111114' --splashBackgroundColor '#111114' --splashBackgroundColorDark '#111114'",
    "version:set": "node scripts/set-version.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
